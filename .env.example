# Variaveis da API (Railway > Service > Variables). Copie para .env em dev.
# Nunca commitar o .env de verdade.

APP_ENV=production                       # development em dev local
PUBLIC_URL=https://fpsx.up.railway.app   # URL publica do site (checkout volta pra ca')
CORS_ORIGINS=https://fpsx.up.railway.app

# Segredo do JWT de sessao. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ── Supabase ──────────────────────────────────────────────────────────────
# Site: pooler em modo TRANSACAO (porta 6543). Project Settings > Database > Connection pooling.
DATABASE_URL=postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
# Migrations: modo SESSAO (porta 5432 do pooler). O advisory lock precisa de sessao propria.
MIGRATIONS_DATABASE_URL=postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
DB_SSLMODE=require
DB_POOL_MAX=10
AUTO_MIGRATE=1

# ── Licencas ─────────────────────────────────────────────────────────────
# Chave PRIVADA EC P-256 que assina licenca e catalogo. A publica correspondente
# esta embutida no app (agent/src/Fpsx.Client/LicenseToken.cs). Cole o PEM com
# as quebras de linha como \n.
LICENSE_PRIVATE_KEY_PEM=

# ── Mercado Pago (PIX e cartao) ──────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
