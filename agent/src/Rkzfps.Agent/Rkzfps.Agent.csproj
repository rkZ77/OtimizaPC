<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Rkzfps.Agent</RootNamespace>
    <AssemblyName>rkzfps</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rkzfps.Core\Rkzfps.Core.csproj" />
    <ProjectReference Include="..\Rkzfps.Windows\Rkzfps.Windows.csproj" />
    <ProjectReference Include="..\Rkzfps.Client\Rkzfps.Client.csproj" />
  </ItemGroup>
  <!-- O catalogo de otimizacoes e os perfis de jogo vivem fora do Agent, na
       raiz do monorepo, porque o admin vai publicar versoes deles sem
       recompilar o executavel. Aqui eles so' sao copiados pro lado do .exe. -->
  <ItemGroup>
    <Content Include="..\..\..\optimization-engine\catalog\*.json" LinkBase="catalog" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\game-profiles\*.json" LinkBase="game-profiles" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\hardware-db\*.json" LinkBase="hardware-db" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
