<UserControl x:Class="Fpsx.App.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="32,28" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Conta" Style="{StaticResource H1}" Margin="0,0,0,18" />

            <!-- Não conectado -->
            <Border Style="{StaticResource Card}" Visibility="{Binding LoggedIn, Converter={StaticResource Hidden}}">
                <StackPanel Width="380" HorizontalAlignment="Left">
                    <TextBlock Text="Entrar" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,14"
                               Text="Entre para ativar este PC no seu plano. Sem conta, o FPSX funciona no plano Free." />
                    <TextBlock Text="E-mail" FontSize="13" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                    <TextBlock Text="Senha" FontSize="13" Margin="0,0,0,4" />
                    <PasswordBox x:Name="Pwd" Margin="0,0,0,14" />
                    <Button Content="Entrar e ativar este PC" Style="{StaticResource Primary}" CommandParameter="{Binding ElementName=Pwd}"
                            Command="{Binding LoginCommand}" IsDefault="True" />
                    <TextBlock Text="{Binding Progress}" Foreground="{StaticResource Accent}" Margin="0,10,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                    <Button Content="Criar conta grátis" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding SignupCommand}" />
                </StackPanel>
            </Border>

            <!-- Conectado -->
            <Border Style="{StaticResource Card}" Visibility="{Binding LoggedIn, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="{Binding License.Email}" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding PlanLabel, StringFormat=Plano {0}}" FontSize="16" />
                    <TextBlock Text="{Binding Expires}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Offline}" Style="{StaticResource MutedText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Gerenciar conta e PCs" Command="{Binding SiteCommand}" Margin="0,0,8,0" />
                        <Button Content="Sincronizar" Command="{Binding SyncCommand}" Margin="0,0,8,0" />
                        <Button Content="Sair" Style="{StaticResource DangerButton}" Command="{Binding LogoutCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Background="{StaticResource Surface2}" Visibility="{Binding License.Notice, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding License.Notice}" Foreground="{StaticResource Warn}" />
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Ver planos" Style="{StaticResource Primary}" Command="{Binding PlansCommand}" />
                        <TextBlock Text="O que o seu plano libera" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Features}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,5">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}"
                                               Text="{Binding Plan, StringFormat=a partir do {0}}" />
                                    <TextBlock DockPanel.Dock="Left" Width="30" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Text" Value="—" />
                                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Included}" Value="True">
                                                        <Setter Property="Text" Value="✓" />
                                                        <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Label}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
