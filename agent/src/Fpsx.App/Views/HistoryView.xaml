<UserControl x:Class="Fpsx.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="32,28">
            <DockPanel Margin="0,0,0,18">
                <Button DockPanel.Dock="Right" Content="Desfazer tudo" Style="{StaticResource DangerButton}" Command="{Binding UndoAllCommand}" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Text="Histórico" Style="{StaticResource H1}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                               Text="Cada sessão guarda o valor anterior de tudo que foi alterado. Desfazer restaura exatamente esse valor. Se você mudou algo depois, o FPSX pergunta antes de sobrescrever." />
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding Progress}" Foreground="{StaticResource Accent}" Margin="0,0,0,10"
                       Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
            <Border Style="{StaticResource Card}" Background="{StaticResource Surface2}" Visibility="{Binding PlanNote, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding PlanNote}" />
            </Border>
            <TextBlock Text="Nenhuma alteração feita pelo FPSX neste PC." Style="{StaticResource MutedText}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />

            <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Desfazer sessão"
                                            CommandParameter="{Binding}"
                                            Command="{Binding DataContext.UndoSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Visibility="{Binding CanUndo, Converter={StaticResource Visible}}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Changes}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,4">
                                                <Button DockPanel.Dock="Right" Content="Desfazer" Style="{StaticResource Ghost}"
                                                        CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.UndoChangeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Visibility="{Binding CanUndo, Converter={StaticResource Visible}}" />
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusLabel}" Width="150" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="13" />
                                                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Warn}" FontSize="12"
                                                               Visibility="{Binding Error, Converter={StaticResource Visible}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
