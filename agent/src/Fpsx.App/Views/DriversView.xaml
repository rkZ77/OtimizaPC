<UserControl x:Class="Fpsx.App.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="32,28" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Drivers e reparo" Style="{StaticResource H1}" Margin="0,0,0,6" />
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,18"
                       Text="Driver novo pelo Windows Update, com ponto de restauração antes, e verificação dos arquivos do Windows." />

            <!-- Drivers do Windows Update -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                            <Button Content="Instalar todos" Style="{StaticResource Primary}" Command="{Binding InstallAllCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding HasManyDrivers, Converter={StaticResource Visible}}" />
                            <Button Content="Procurar de novo" Command="{Binding SearchCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Drivers novos do Windows Update" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding SearchText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Drivers}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,12">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Instalar" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="16,0,0,0"
                                                CommandParameter="{Binding}"
                                                Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="O driver vem do próprio Windows Update, assinado pela Microsoft. Antes de instalar, o RKZFPS cria um ponto de restauração do Windows. Para voltar ao driver anterior: Gerenciador de Dispositivos, Propriedades do aparelho, Reverter driver." />
                    <TextBlock Text="{Binding Progress}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                </StackPanel>
            </Border>

            <!-- Site do fabricante -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Direto do fabricante" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="O driver de vídeo mais novo costuma sair primeiro no atualizador do fabricante. Cada botão abre o atualizador ou a página oficial, que acha o driver certo para o seu modelo." />
                    <ItemsControl ItemsSource="{Binding DriverLinks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Margin="0,0,8,8" CommandParameter="{Binding Target}"
                                        Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Troca de peça e formatação -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Troca de peça e formatação" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Text="O RKZFPS nota quando uma peça muda e diz se precisa formatar. Antes de formatar, salve os drivers deste PC num pendrive; depois, o app reinstala todos, inclusive o de rede, sem internet." />

                    <!-- Peças trocadas desde a última análise -->
                    <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="14" Margin="0,12,0,0"
                            Visibility="{Binding HasHardwareChanges, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding HardwareChanges}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                                <Run Text="{Binding Part, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding To, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="Formatar é o recomendado" Foreground="{StaticResource Warn}" FontWeight="SemiBold" Margin="0,2,0,0"
                                                       Visibility="{Binding FormatRecommended, Converter={StaticResource Visible}}" />
                                            <TextBlock Text="{Binding Steps}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Entendi" HorizontalAlignment="Left" Command="{Binding DismissChangesCommand}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Antes de formatar" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Text="1. Faça backup dos seus arquivos. 2. Salve os drivers num pendrive (botão abaixo): vai junto um LEIA-ME com as peças do PC. 3. Crie o pendrive de instalação pelo site da Microsoft. A licença do Windows volta sozinha, ligada ao PC e à sua conta Microsoft." />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Salvar drivers para formatar" Style="{StaticResource Secondary}" Command="{Binding ExportCommand}" Margin="0,0,8,8" />
                        <Button Content="Pendrive do Windows (Microsoft)" Command="{Binding WindowsMediaCommand}" Margin="0,0,8,8" />
                    </WrapPanel>

                    <TextBlock Text="Depois de formatar" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Text="Instale o RKZFPS, entre na conta e escolha a pasta RKZFPS drivers do pendrive. O app confere cada arquivo antes de instalar." />
                    <Button Content="Reinstalar drivers salvos" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Command="{Binding RestoreKitCommand}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding KitText}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding KitText, Converter={StaticResource Visible}}" />
                </StackPanel>
            </Border>

            <!-- Arquivos do Windows -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                            <Button Content="Reparar arquivos" Style="{StaticResource Secondary}" Command="{Binding RepairCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding CanRepair, Converter={StaticResource Visible}}" />
                            <Button Content="Verificar" Style="{StaticResource Secondary}" Command="{Binding CheckCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding HealthTitle}" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding HealthText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="Verificar só lê. Reparar usa as ferramentas da Microsoft (DISM e SFC), troca arquivos estragados pelos originais e pode levar até 30 minutos. Útil para tela azul, programa fechando sozinho e erro de DLL; não aumenta FPS." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
