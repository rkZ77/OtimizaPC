<UserControl x:Class="Fpsx.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="32,28" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Configurações" Style="{StaticResource H1}" Margin="0,0,0,18" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Modo de uso" Style="{StaticResource H2}" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Advanced}" Content="Modo avançado" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="54,4,0,0" TextWrapping="Wrap"
                               Text="Desligado (modo simples): só o essencial, com botões grandes. Ligado: mostra também cada otimização item a item, o benchmark, o teste de CPU e os detalhes técnicos do PC." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Avisos na bandeja" Style="{StaticResource H2}" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding WatchNotify}" Content="Vigiar o PC e mandar o resumo da semana" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="54,4,0,0" TextWrapping="Wrap"
                               Text="Com o RKZFPS na bandeja, ele analisa o PC depois que o Windows liga e a cada 6 horas, só lendo. Avisa quando uma atualização do Windows, um driver novo ou um jogo desfez uma correção ou criou um problema. Uma vez por semana, mostra o FPS medido nas suas partidas." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Perfil de otimização" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,10"
                               Text="O perfil decide o que o botão Otimizar agora seleciona sozinho. Tudo continua disponível para escolha item a item." />
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" Width="420" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text=": " />
                                    <Run Text="{Binding Description, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Privacidade" Style="{StaticResource H2}" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Telemetry}" Content="Enviar dados anônimos de uso para melhorar o RKZFPS" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="54,6,0,0"
                               Text="Somente: otimizações aplicadas e se funcionaram, o FPS das partidas medidas (números e gráfico), um resumo do hardware (processador, placa de vídeo, memória, Windows) e a versão do app. É o que permite comparar seu PC com PCs parecidos. Nunca arquivos, nomes de programas, nome do PC, caminhos ou conteúdo pessoal." />
                    <Button Content="Política de privacidade" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="42,6,0,0" Command="{Binding PrivacyCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Sobre" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding Version}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,10"
                               Text="Backups, histórico e logs ficam neste PC, na pasta de dados do RKZFPS." />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Abrir pasta de dados" Command="{Binding OpenDataCommand}" />
                        <Button Content="Instagram @rkzfps.br" Style="{StaticResource Ghost}" Margin="10,0,0,0" Command="{Binding InstagramCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
