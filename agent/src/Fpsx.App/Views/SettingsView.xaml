<UserControl x:Class="Fpsx.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="32,28" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Configurações" Style="{StaticResource H1}" Margin="0,0,0,18" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Perfil de otimização" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,10"
                               Text="O perfil decide o que o botão Otimizar agora seleciona sozinho. Tudo continua disponível para escolha item a item." />
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" Width="320" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="Black">
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding Description, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Privacidade" Style="{StaticResource H2}" />
                    <CheckBox IsChecked="{Binding Telemetry}" Content="Enviar dados anônimos de uso para melhorar o FPSX" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="26,6,0,0"
                               Text="Somente: otimizações aplicadas e se funcionaram, resultados de benchmark, versão do app e do Windows. Nunca arquivos, nomes de programas, caminhos ou conteúdo pessoal." />
                    <Button Content="Política de privacidade" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="20,6,0,0" Command="{Binding PrivacyCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Sobre" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding Version}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,10"
                               Text="Backups, histórico e logs ficam neste PC, na pasta de dados do FPSX." />
                    <Button Content="Abrir pasta de dados" HorizontalAlignment="Left" Command="{Binding OpenDataCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
