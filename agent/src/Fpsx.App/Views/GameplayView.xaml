<UserControl x:Class="Fpsx.App.Views.GameplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Fpsx.App">
    <UserControl.Resources>
        <!-- Legenda das duas linhas do gráfico -->
        <StackPanel x:Key="Legend" x:Shared="False" Orientation="Horizontal" Margin="0,8,0,0">
            <Rectangle Width="12" Height="3" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
            <TextBlock Text="FPS médio" Style="{StaticResource MutedText}" FontSize="12" Margin="6,0,18,0" />
            <Rectangle Width="12" Height="3" Fill="{DynamicResource Warn}" VerticalAlignment="Center" />
            <TextBlock Text="Pior quadro (os picos para baixo são as travadas)" Style="{StaticResource MutedText}" FontSize="12" Margin="6,0,0,0" />
        </StackPanel>
    </UserControl.Resources>
    <ScrollViewer>
        <StackPanel Margin="32,28">
            <TextBlock Text="Partidas" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,18"
                       Text="O RKZFPS mede o FPS de cada partida sozinho, com o jogo aberto, e mostra se ele mudou depois de uma otimização. Só entram os minutos com o jogo em primeiro plano, depois do carregamento. Nada no jogo é alterado para medir." />

            <!-- Ao vivo, enquanto o jogo roda -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsLive, Converter={StaticResource Visible}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse Width="9" Height="9" Fill="{DynamicResource Danger}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding LiveTitle}" Style="{StaticResource H2}" Margin="0" />
                    </StackPanel>
                    <app:FpsChart Points="{Binding LivePoints}" />
                    <ContentControl Content="{StaticResource Legend}" />
                    <TextBlock Text="{Binding LiveSummary}" Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LiveHealth}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="13"
                               Visibility="{Binding LiveHealth, Converter={StaticResource Visible}}" />
                </StackPanel>
            </Border>

            <!-- Gráfico da partida escolhida -->
            <Border Style="{StaticResource Card}" Visibility="{Binding Sessions.Count, Converter={StaticResource Visible}}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Compartilhar" Command="{Binding ShareCommand}" VerticalAlignment="Top"
                                ToolTip="Gera uma imagem da partida com os números e o gráfico, pronta para colar no Discord ou no WhatsApp" />
                        <TextBlock Text="FPS durante a partida" Style="{StaticResource H2}" />
                    </DockPanel>
                    <TextBlock Text="{Binding ChartTitle}" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                    <app:FpsChart Points="{Binding ChartPoints}" MonitorHz="{Binding ChartHz}" Drops="{Binding ChartDrops}" />
                    <ContentControl Content="{StaticResource Legend}" />
                    <TextBlock Text="{Binding ChartNote}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="12,10" Margin="0,10,0,0"
                            Visibility="{Binding ChartCauses, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding ChartCauses}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </Border>
                    <Border BorderBrush="{Binding HzBrush}" BorderThickness="3,0,0,0" Background="{DynamicResource Surface2}" CornerRadius="4" Padding="12,10" Margin="0,10,0,0"
                            Visibility="{Binding HzText, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding HzText}" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="{Binding PeerNote}" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,10,0,0"
                               Visibility="{Binding PeerNote, Converter={StaticResource Visible}}" />
                </StackPanel>
            </Border>

            <!-- O que limitou a partida escolhida, com os números que sustentam a conclusão -->
            <Border Style="{StaticResource Card}" Visibility="{Binding Sessions.Count, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="O que limitou esta partida" Style="{StaticResource H2}" />
                    <Border BorderBrush="{Binding DiagBrush}" BorderThickness="3,0,0,0" Background="{DynamicResource Surface2}" CornerRadius="4" Padding="12,10" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding DiagTitle}" FontWeight="Bold" Foreground="{Binding DiagBrush}" />
                            <TextBlock Text="{Binding DiagWhy}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding DiagAdvice}" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                       Visibility="{Binding DiagAdvice, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </Border>
                    <!-- Placa de vídeo que o jogo usou. Partida antiga (sem a leitura) não mostra o bloco. -->
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding HasGpu, Converter={StaticResource Visible}}">
                        <TextBlock Text="Placa de vídeo" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="GPU utilizada" Style="{StaticResource MutedText}" FontSize="13" />
                            <TextBlock Grid.Column="1" Text="{Binding GpuUsed}" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Text="GPU de alto desempenho" Style="{StaticResource MutedText}" FontSize="13" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GpuBest}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="2" Text="Status" Style="{StaticResource MutedText}" FontSize="13" Margin="0,4,0,0" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding GpuGlyph}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding GpuBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding GpuStatus}" Foreground="{Binding GpuBrush}" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding GpuText}" TextWrapping="Wrap" FontSize="13" Margin="0,6,0,0" />
                        <Button Content="Ver como corrigir" Command="{Binding GpuFixCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Visibility="{Binding GpuFixable, Converter={StaticResource Visible}}" />
                    </StackPanel>

                    <TextBlock Text="Dados usados no diagnóstico" FontWeight="SemiBold" Margin="0,14,0,6" />
                    <ItemsControl ItemsSource="{Binding Evidence}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Tag}" Foreground="{Binding Tone}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Configuração do jogo" FontWeight="SemiBold" Margin="0,14,0,4" />
                    <TextBlock Text="{Binding SettingsText}" TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="13" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="Nenhuma conclusão sai de uma métrica só: cada categoria exige dois sinais que concordam. Medido é lido direto do Windows ou do driver; calculado é conta feita sobre o que foi medido." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Medição automática" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding MonitorStatus}" Foreground="{DynamicResource Accent}" Margin="0,0,0,10" TextWrapping="Wrap" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoMeasure}" Content="Medir o FPS das minhas partidas automaticamente" />
                    <TextBlock Text="{Binding MeasuredGames}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="54,4,0,0" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" Margin="0,8,0,0"
                              Content="Iniciar com o Windows, na bandeja, para medir sempre que eu jogar" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="54,4,0,0"
                               Text="Fechar a janela deixa o RKZFPS na bandeja, perto do relógio. Para encerrar de vez, clique com o botão direito no ícone e escolha Sair." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Antes e depois da otimização" Style="{StaticResource H2}" />
                    <WrapPanel Margin="0,0,0,10">
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Text="Otimização" FontSize="13" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Pivots}" SelectedItem="{Binding SelectedPivot}" DisplayMemberPath="Label" MinWidth="360" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Text="Jogo" FontSize="13" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" MinWidth="200" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding CompareStatus}" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <ItemsControl ItemsSource="{Binding Metrics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Before, StringFormat=antes {0}}" Style="{StaticResource MutedText}" />
                                    <TextBlock Grid.Column="2" Text="{Binding After, StringFormat=depois {0}}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Delta}" Foreground="{Binding Tone}" FontWeight="Bold" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Verdict}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10,0,0"
                               Visibility="{Binding Verdict, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"
                               Visibility="{Binding Warnings, Converter={StaticResource Visible}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Exportar planilha" Command="{Binding ExportCommand}" Margin="0,0,8,0"
                                    ToolTip="Salva as partidas da lista num arquivo que abre no Excel ou no Google Planilhas" />
                            <ComboBox ItemsSource="{Binding HistoryGames}" SelectedItem="{Binding HistoryGame}" MinWidth="200" />
                        </StackPanel>
                        <TextBlock Text="Partidas medidas" Style="{StaticResource H2}" />
                    </DockPanel>
                    <TextBlock Text="{Binding HistorySummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6"
                               Visibility="{Binding HistorySummary, Converter={StaticResource Visible}}" />

                    <!-- Meta de FPS do jogo escolhido no filtro -->
                    <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
                            Visibility="{Binding HasGameSelected, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Salvar meta" Command="{Binding SaveGoalCommand}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Meta de FPS" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBox Text="{Binding GoalText, UpdateSourceTrigger=PropertyChanged}" Width="90" VerticalAlignment="Center"
                                             ToolTip="O FPS médio que você quer neste jogo. Vazio tira a meta." />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding GoalResult}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Clique numa partida para ver o gráfico e o diagnóstico dela." Style="{StaticResource MutedText}" Margin="0,0,0,6"
                               Visibility="{Binding Sessions.Count, Converter={StaticResource Visible}}" />
                    <TextBlock Text="Nenhuma partida ainda." Style="{StaticResource MutedText}"
                               Visibility="{Binding Sessions.Count, Converter={StaticResource Hidden}}" />
                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,3" Padding="14,10" HorizontalContentAlignment="Left" CommandParameter="{Binding}"
                                        Command="{Binding DataContext.SelectSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <DockPanel>
                                        <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource GameBadge}"
                                                        VerticalAlignment="Center" Margin="0,0,12,0" Focusable="False" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Stats}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap">
                                                <Run Text="{Binding Diagnosis.Title, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding Details, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
