<Application x:Class="Fpsx.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Fpsx.App"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToVisibility x:Key="Visible" />
            <local:BoolToVisibility x:Key="Hidden" Invert="True" />

            <!-- Ícone do jogo (tirado do .exe instalado) ou as iniciais enquanto ele não foi visto -->
            <DataTemplate x:Key="GameBadge">
                <Grid Width="40" Height="40">
                    <Border CornerRadius="10" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                            Visibility="{Binding Icon, Converter={StaticResource Hidden}}">
                        <TextBlock Text="{Binding Initials}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding Icon, Converter={StaticResource Visible}}" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
