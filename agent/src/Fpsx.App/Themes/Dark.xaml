<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tema escuro (padrão). Tokens de cor: cor se muda AQUI, nunca solta numa
         tela (regra do Pickia). O Light.xaml tem as mesmas chaves; as telas usam
         DynamicResource para a troca valer na hora, sem reiniciar. -->
    <Color x:Key="BgColor">#0E1116</Color>
    <Color x:Key="SurfaceColor">#161B22</Color>
    <Color x:Key="Surface2Color">#1E252F</Color>
    <!-- Item em foco numa lista (seletor aberto). -->
    <Color x:Key="Surface3Color">#2A323D</Color>
    <Color x:Key="BorderColor">#2A323D</Color>
    <Color x:Key="TextColor">#E6EDF3</Color>
    <Color x:Key="MutedColor">#8B97A6</Color>
    <!-- Ciano da marca RKZFPS (arte do logo) -->
    <Color x:Key="AccentColor">#19D3F2</Color>
    <Color x:Key="AccentHoverColor">#5CE1F6</Color>
    <Color x:Key="WarnColor">#F2B84B</Color>
    <Color x:Key="DangerColor">#F2545B</Color>
    <Color x:Key="InfoColor">#58A6FF</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <!-- Fechar da barra de titulo: o vermelho do proprio Windows, para ninguem estranhar. -->
    <SolidColorBrush x:Key="CaptionClose" Color="#C42B1C" />
    <!-- Accent, Warn, Danger e Info são a cor como TEXTO e linha. -->
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <!-- Ciano como PREENCHIMENTO (botão principal, chave ligada): igual nos dois temas, a marca não muda. -->
    <SolidColorBrush x:Key="AccentFill" Color="#19D3F2" />
    <SolidColorBrush x:Key="AccentFillHover" Color="#5CE1F6" />
    <!-- Texto por cima do ciano cheio. -->
    <SolidColorBrush x:Key="OnAccent" Color="#06140D" />
    <!-- Texto por cima de selo colorido (OK, ATENÇÃO...) pintado com Accent, Warn, Danger ou Info. -->
    <SolidColorBrush x:Key="OnFill" Color="#0E1116" />
    <!-- Ciano de fundo e de contorno para o botão secundário: o cheio fica só na ação principal da tela. -->
    <SolidColorBrush x:Key="AccentSoft" Color="#1F19D3F2" />
    <SolidColorBrush x:Key="AccentSoftHover" Color="#3319D3F2" />
    <SolidColorBrush x:Key="AccentLine" Color="#7319D3F2" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#3A4452" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#56626F" />
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="Info" Color="{StaticResource InfoColor}" />
</ResourceDictionary>
