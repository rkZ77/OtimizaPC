<Window x:Class="Fpsx.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Fpsx.App.ViewModels"
        xmlns:v="clr-namespace:Fpsx.App.Views"
        Title="RKZFPS" Width="1180" Height="780" MinWidth="960" MinHeight="620"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        Icon="Assets/fpsx.ico">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptimizationsViewModel}"><v:OptimizationsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamesViewModel}"><v:GamesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameplayViewModel}"><v:GameplayView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BenchmarkViewModel}"><v:BenchmarkView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><v:HistoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountViewModel}"><v:AccountView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UpdatesViewModel}"><v:UpdatesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barra lateral -->
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,26">
                    <Image Source="Assets/fpsx.ico" Width="30" Height="30" />
                    <TextBlock FontSize="22" FontWeight="Black" FontStyle="Italic" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Run Text="RKZ" /><Run Text="FPS" Foreground="{StaticResource Accent}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="8,0">
                    <Button Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="-6,0,0,12" Command="{Binding TutorialCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Info}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Como usar o RKZFPS" Foreground="{StaticResource Info}" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource Chip}" Background="{StaticResource Surface2}" Margin="0,0,0,10">
                        <TextBlock Text="{Binding PlanLabel, StringFormat=Plano {0}}" FontSize="13" />
                    </Border>
                    <!-- Sem aviso de "sem administrador": o app pede a permissão do
                         Windows sozinho, só na hora de aplicar o que precisa dela. -->
                    <TextBlock Text="{Binding PlanHint}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"
                               Visibility="{Binding PlanHint, Converter={StaticResource Visible}}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Pages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="nav" Style="{StaticResource NavItem}" IsChecked="{Binding IsCurrent, Mode=TwoWay}"
                                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Conteúdo -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="{StaticResource Info}" Padding="16,8"
                    Visibility="{Binding UpdateAvailable, Converter={StaticResource Visible}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{Binding UpdateButton}" Command="{Binding UpdateCommand}" Padding="14,6" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding UpdateAvailable}" Foreground="#06121F" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <!-- FPS ao vivo: aparece sozinho quando um jogo abre, em qualquer tela. -->
            <Border DockPanel.Dock="Top" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="20,10"
                    Visibility="{Binding LiveFps, Converter={StaticResource Visible}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEC4A;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding LiveFps}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource Accent}" />
                </StackPanel>
            </Border>
            <ContentControl Content="{Binding Current}" />
        </DockPanel>
    </Grid>
</Window>
