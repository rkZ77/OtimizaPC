<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tema claro: a mesma rampa do site (frontend/src/index.css, data-theme="light").
         Superfície e tinta invertem; as cores de destaque escritas fecham na
         mesma matiz, porque o tom que se lê sobre #0E1116 some sobre branco.
         O ciano CHEIO (botão principal, chave ligada) não muda: é a marca. -->
    <Color x:Key="BgColor">#FFFFFF</Color>
    <Color x:Key="SurfaceColor">#F5F5F7</Color>
    <Color x:Key="Surface2Color">#ECECEF</Color>
    <Color x:Key="Surface3Color">#E0E0E5</Color>
    <!-- Um degrau mais forte que a linha padrão do site: no app o cartão se separa do fundo só pela borda. -->
    <Color x:Key="BorderColor">#D5D5DC</Color>
    <!-- Tinta validada em WCAG sobre branco: 18.3:1 e 5.9:1. -->
    <Color x:Key="TextColor">#16161A</Color>
    <Color x:Key="MutedColor">#64646E</Color>
    <!-- Ciano escurecido na mesma matiz (o accent-ink do site), legível sobre branco. -->
    <Color x:Key="AccentColor">#0E7490</Color>
    <Color x:Key="AccentHoverColor">#0B5F76</Color>
    <Color x:Key="WarnColor">#B45309</Color>
    <Color x:Key="DangerColor">#C62828</Color>
    <Color x:Key="InfoColor">#1D4ED8</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="CaptionClose" Color="#C42B1C" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentFill" Color="#19D3F2" />
    <SolidColorBrush x:Key="AccentFillHover" Color="#47DCF4" />
    <SolidColorBrush x:Key="OnAccent" Color="#06140D" />
    <!-- Selos aqui são pintados com o tom fechado: texto branco (acima de 5:1 em todos). -->
    <SolidColorBrush x:Key="OnFill" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#1A0E7490" />
    <SolidColorBrush x:Key="AccentSoftHover" Color="#2E0E7490" />
    <SolidColorBrush x:Key="AccentLine" Color="#730E7490" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#C4C4CC" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#A5A5AF" />
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="Info" Color="{StaticResource InfoColor}" />
</ResourceDictionary>
