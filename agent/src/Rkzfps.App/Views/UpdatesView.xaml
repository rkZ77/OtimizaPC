<UserControl x:Class="Rkzfps.App.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="32,28" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Atualizações" Style="{StaticResource H1}" Margin="0,0,0,18" />

            <!-- Situação agora, como no Windows Update: ícone, frase e os dois botões -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Content="{Binding InstallLabel}" Style="{StaticResource Primary}" Command="{Binding InstallCommand}"
                                Visibility="{Binding HasUpdate, Converter={StaticResource Visible}}" Margin="0,0,0,8" />
                        <Button Content="Verificar agora" Command="{Binding CheckCommand}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                               Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource H2}" Margin="0" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding CurrentVersion}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- O que a versão nova traz -->
            <Border Style="{StaticResource Card}" Visibility="{Binding HasUpdate, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="O que muda nesta versão" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" LineHeight="21" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Como o RKZFPS se atualiza" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding AutoInfo}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                    <Button Content="Ver todas as versões no site" Command="{Binding AllVersionsCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
