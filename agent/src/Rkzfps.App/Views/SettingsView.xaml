<UserControl x:Class="Rkzfps.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Uma linha por opção: nome à esquerda, controle à direita, explicação no "i". -->
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,10" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer>
        <StackPanel Margin="32,28" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Configurações" Style="{StaticResource H1}" Margin="0,0,0,18" />

            <!-- Perfil: o que mais muda o que o RKZFPS recomenda, por isso no topo. -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Perfil de otimização" Style="{StaticResource H2}" Margin="0" />
                        <TextBlock Style="{StaticResource InfoTip}"
                                   ToolTip="O RKZFPS junta o perfil com o seu hardware e os seus jogos para decidir o que recomendar. Tudo continua disponível para escolha item a item." />
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}" Width="300" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding Choice.Description}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding AdvancedNote}" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                               Visibility="{Binding AdvancedNote, Converter={StaticResource Visible}}" />

                    <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="14,12" Margin="0,12,0,0"
                            Visibility="{Binding TuningSummary, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TuningSummary}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="640" />
                                <TextBlock Style="{StaticResource InfoTip}" ToolTip="{Binding TuningReasons}"
                                           Visibility="{Binding TuningReasons, Converter={StaticResource Visible}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- Cor no próprio texto: o estilo implícito de TextBlock do tema cobre a cor herdada do botão. -->
                    <Button Style="{StaticResource Ghost}" HorizontalAlignment="Left" Padding="0,6" Margin="0,8,0,0" Command="{Binding AskAgainCommand}">
                        <TextBlock Text="Responder as perguntas de novo" Foreground="{DynamicResource Accent}" />
                    </Button>

                    <StackPanel Margin="0,10,0,0" Visibility="{Binding Advanced, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Perfis avançados" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource InfoTip}"
                                       ToolTip="Os perfis internos do RKZFPS, como Streaming. Escolher um aqui troca o perfil principal acima." />
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding AdvancedProfile}" Width="300" HorizontalAlignment="Left">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Description}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Opções gerais -->
            <Border Style="{StaticResource Card}" Padding="18,8">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Background="{DynamicResource Surface2}" CornerRadius="10" Padding="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="theme" Content="Escuro" IsChecked="{Binding IsDark}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="theme" Content="Claro" IsChecked="{Binding IsLight}" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Tema" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource InfoTip}" ToolTip="Escuro ou claro, igual ao site. Também troca pelo sol ou pela lua no alto da janela." />
                        </StackPanel>
                    </DockPanel>

                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" />
                    <StackPanel Margin="0,10">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding OverlayHotkey}" Content="Painel de FPS por cima do jogo (Ctrl+Shift+F)" />
                            <TextBlock Style="{StaticResource InfoTip}"
                                       ToolTip="Mostra o FPS, o pior quadro e o uso de CPU e GPU no canto da tela enquanto você joga. Não mexe no jogo e não conflita com anti-cheat. Aparece com o jogo em janela sem borda; em tela cheia exclusiva o próprio jogo cobre o painel." />
                        </StackPanel>
                        <TextBlock Text="{Binding OverlayStatus}" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" Margin="54,6,0,0"
                                   Visibility="{Binding OverlayStatus, Converter={StaticResource Visible}}" />
                    </StackPanel>

                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Advanced}" Content="Modo avançado" />
                        <TextBlock Style="{StaticResource InfoTip}"
                                   ToolTip="Desligado: só o essencial, com botões grandes. Ligado: mostra também cada otimização item a item, o benchmark, o teste de CPU e os detalhes técnicos do PC." />
                    </StackPanel>

                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding WatchNotify}" Content="Vigiar o PC e mandar o resumo da semana" />
                        <TextBlock Style="{StaticResource InfoTip}"
                                   ToolTip="Com o RKZFPS na bandeja, ele analisa o PC depois que o Windows liga e a cada 6 horas, só lendo. Avisa quando uma atualização do Windows, um driver novo ou um jogo desfez uma correção ou criou um problema. Uma vez por semana, mostra o FPS medido nas suas partidas." />
                    </StackPanel>

                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" />
                    <DockPanel Style="{StaticResource Row}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" VerticalAlignment="Center" Command="{Binding PrivacyCommand}">
                            <TextBlock Text="Política de privacidade" Foreground="{DynamicResource Accent}" />
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Telemetry}" Content="Enviar dados anônimos de uso" />
                            <TextBlock Style="{StaticResource InfoTip}"
                                       ToolTip="Somente: otimizações aplicadas e se funcionaram, o FPS das partidas medidas (números e gráfico), um resumo do hardware (processador, placa de vídeo, memória, Windows) e a versão do app. É o que permite comparar seu PC com PCs parecidos. Nunca arquivos, nomes de programas, nome do PC, caminhos ou conteúdo pessoal." />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Abrir pasta de dados" Command="{Binding OpenDataCommand}"
                                ToolTip="Backups, histórico e logs ficam neste PC, na pasta de dados do RKZFPS." />
                        <Button Style="{StaticResource Ghost}" Margin="10,0,0,0" Command="{Binding InstagramCommand}">
                            <TextBlock Text="Instagram @rkzfps.br" Foreground="{DynamicResource Accent}" />
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding Version}" VerticalAlignment="Center" FontWeight="SemiBold" />
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
