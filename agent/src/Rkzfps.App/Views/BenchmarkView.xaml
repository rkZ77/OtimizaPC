<UserControl x:Class="Rkzfps.App.Views.BenchmarkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="32,28">
            <TextBlock Text="RKZFPS Benchmark" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,18"
                       Text="Mede FPS médio, 1% low, 0.1% low, frametime e stutter com o PresentMon. Capture antes e depois de otimizar, no mesmo cenário. Se a diferença estiver dentro da variação normal, o RKZFPS diz que não houve ganho." />

            <Border Style="{StaticResource Card}" Background="{DynamicResource Surface2}" Visibility="{Binding Allowed, Converter={StaticResource Hidden}}">
                <TextBlock Text="{Binding PlanNote}" />
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding Allowed, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="Nova captura" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding Method}" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Rótulo" FontSize="13" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Labels}" SelectedItem="{Binding Label}" Width="140" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Duração (s)" FontSize="13" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Duration}" Width="90" />
                        </StackPanel>
                        <Button Content="Capturar agora" Style="{StaticResource Primary}" Command="{Binding RunCommand}" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock Text="{Binding Progress}" Foreground="{DynamicResource Accent}" Margin="0,12,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Comparar antes e depois" Command="{Binding CompareCommand}" />
                        <TextBlock Text="Capturas" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="Nenhuma captura ainda." Style="{StaticResource MutedText}"
                               Visibility="{Binding Runs.Count, Converter={StaticResource Hidden}}" />
                    <ItemsControl ItemsSource="{Binding Runs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <CheckBox Content="Antes" IsChecked="{Binding IsBefore}" Margin="0,0,14,0" />
                                        <CheckBox Content="Depois" IsChecked="{Binding IsAfter}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Stats}" Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding Result, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="Resultado" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding Result}" LineHeight="22" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
