<UserControl x:Class="Rkzfps.App.Views.OptimizationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Chave ON/OFF (como o FPS Boost da GamersClub). E' um botao: o estado
             vem do motor (Tag = ligada), e o clique aplica ou desfaz de verdade. -->
        <Style x:Key="BoostSwitch" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="track" Width="64" Height="28" CornerRadius="14" Background="{DynamicResource Surface2}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <Grid>
                                <TextBlock x:Name="label" Text="OFF" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,9,0" />
                                <Ellipse x:Name="knob" Width="20" Height="20" Fill="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="4,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentFill}" />
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource AccentFill}" />
                                <Setter TargetName="label" Property="Text" Value="ON" />
                                <Setter TargetName="label" Property="Foreground" Value="{DynamicResource OnAccent}" />
                                <Setter TargetName="label" Property="HorizontalAlignment" Value="Left" />
                                <Setter TargetName="label" Property="Margin" Value="10,0,0,0" />
                                <Setter TargetName="knob" Property="Fill" Value="{DynamicResource OnAccent}" />
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="knob" Property="Margin" Value="0,0,4,0" />
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="track" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="32,14">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Aplicar os marcados" Style="{StaticResource Primary}" Command="{Binding ApplyCommand}" />
                <TextBlock Text="{Binding Progress}" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <ScrollViewer>
            <StackPanel Margin="32,28">
                <DockPanel Margin="0,0,0,18">
                    <Button DockPanel.Dock="Right" Content="Analisar de novo" Command="{Binding ScanCommand}" VerticalAlignment="Top" />
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="FPS Boost" Style="{StaticResource H1}" />
                            <TextBlock Style="{StaticResource InfoTip}" FontSize="16" Margin="10,6,0,0"
                                       ToolTip="Ligue o que quiser. Cada chave guarda como estava antes, e desligar volta ao que era. Passe o mouse num item para ver os detalhes." />
                        </StackPanel>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="14" Margin="0,6,0,0" Visibility="{Binding HasScan, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="Rode a análise na tela Início para ver as otimizações deste PC." Style="{StaticResource MutedText}"
                           Visibility="{Binding HasScan, Converter={StaticResource Hidden}}" />

                <!-- Modo Gaming: qual está ativo fica visível no seletor e na frase logo abaixo -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource Surface2}" CornerRadius="10" Padding="4" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="gaming" Content="Automático" IsChecked="{Binding IsAuto}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="gaming" Content="Manual" IsChecked="{Binding IsManual}" />
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Modo Gaming" Style="{StaticResource H2}" />
                                <TextBlock Text="{Binding GamingModeText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding GamingStatus}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding GamingStatus, Converter={StaticResource Visible}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
                            <TextBlock Text="O que o Automático pode fazer" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource InfoTip}"
                                       ToolTip="Só entra aqui o que tem volta, não precisa de administrador nem de reiniciar e vale na hora, com o jogo já aberto. Fechar programas, mudar arquivos do jogo, a tela ou drivers nunca acontece sozinho." />
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="13" Text="Nada para fazer neste PC agora: o que ele liga sozinho já está certo."
                                   Visibility="{Binding HasGamingCandidates, Converter={StaticResource Hidden}}" />
                        <ItemsControl ItemsSource="{Binding GamingCandidates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Authorized}" Content="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding State}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="54,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <!-- Grupo aberto: título. Grupo de consulta: título clicável com contador. -->
                                <TextBlock Text="{Binding Header}" Style="{StaticResource H2}" Margin="0,8,0,8"
                                           Visibility="{Binding Collapsible, Converter={StaticResource Hidden}}" />
                                <Button Command="{Binding ToggleCommand}" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Padding="0,6"
                                        Visibility="{Binding Collapsible, Converter={StaticResource Visible}}" ToolTip="{Binding Hint}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Chevron}" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Header}" FontSize="16" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>

                                <!-- Uma linha por otimização: o que é e por que à esquerda, a chave à direita. Detalhe técnico no mouse. -->
                                <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding ShowCards, Converter={StaticResource Visible}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8" ToolTip="{Binding Meta}">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                                            <Border Style="{StaticResource Chip}" Background="{DynamicResource Surface2}" Margin="0,0,10,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsLocked, Converter={StaticResource Visible}}">
                                                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Warn}">
                                                                    <Run Text="&#xE735;" FontFamily="Segoe MDL2 Assets" /><Run Text=" " /><Run Text="{Binding PlanBadge, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </Border>
                                                            <Button Style="{StaticResource BoostSwitch}" CommandParameter="{Binding}"
                                                                    Command="{Binding DataContext.SwitchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    Visibility="{Binding ShowSwitch, Converter={StaticResource Visible}}" />
                                                            <Button Content="Fazer agora" Style="{StaticResource Secondary}" CommandParameter="{Binding}"
                                                                    Command="{Binding DataContext.RepairCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    Visibility="{Binding ShowAction, Converter={StaticResource Visible}}" />
                                                            <Button Content="Escolher" CommandParameter="{Binding}"
                                                                    Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    Visibility="{Binding ShowPick, Converter={StaticResource Visible}}" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                            <TextBlock Text="{Binding Warning, StringFormat=Atenção: {0}}" Foreground="{DynamicResource Warn}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                                                       Visibility="{Binding Warning, Converter={StaticResource Visible}}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <!-- Várias alterações (programas de inicialização, jogos): a pessoa marca quais. -->
                                                    <ItemsControl ItemsSource="{Binding Proposals}" Margin="0,10,0,0"
                                                                  Visibility="{Binding Picking, Converter={StaticResource Visible}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding Actionable}" Margin="0,2" ToolTip="{Binding Changes}">
                                                                    <TextBlock Text="{Binding Title}" Margin="6,0,0,0" />
                                                                </CheckBox>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Grupo de consulta aberto: lista simples, uma linha por item. -->
                                <Border Style="{StaticResource Card}" Padding="16,8" Visibility="{Binding ShowRows, Converter={StaticResource Visible}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,6" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="0,8" ToolTip="{Binding Reason}">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{Binding DecisionBrush}">
                                                                    <TextBlock Text="{Binding DecisionLabel}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource OnFill}" />
                                                                </Border>
                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                            </DockPanel>
                                                            <!-- Reparo é de uma vez só: botão, não chave. -->
                                                            <Button Content="Executar" HorizontalAlignment="Left" Margin="0,6,0,0" CommandParameter="{Binding}"
                                                                    Command="{Binding DataContext.RepairCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    Visibility="{Binding ShowRepair, Converter={StaticResource Visible}}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
