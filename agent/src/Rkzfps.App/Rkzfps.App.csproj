<Project Sdk="Microsoft.NET.Sdk">
  <!-- O app que o cliente instala. Mesmo motor do CLI (Rkzfps.Core + Windows +
       Client), com interface. Nenhuma biblioteca de UI de terceiros: menos
       dependencia para auditar num programa que mexe no sistema. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Só pelo NotifyIcon (ícone na bandeja), que o WPF não tem. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Rkzfps.App</RootNamespace>
    <AssemblyName>RKZFPS</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\rkzfps.ico</ApplicationIcon>
    <Product>RKZFPS</Product>
    <Company>RKZFPS</Company>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rkzfps.Core\Rkzfps.Core.csproj" />
    <ProjectReference Include="..\Rkzfps.Windows\Rkzfps.Windows.csproj" />
    <ProjectReference Include="..\Rkzfps.Client\Rkzfps.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Sem estes, Application, MessageBox e Button ficam ambíguos entre WPF e WinForms. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\rkzfps.ico" />
    <Content Include="..\..\..\optimization-engine\catalog\*.json" LinkBase="catalog" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\game-profiles\*.json" LinkBase="game-profiles" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\hardware-db\*.json" LinkBase="hardware-db" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
