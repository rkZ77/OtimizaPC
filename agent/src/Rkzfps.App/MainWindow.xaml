<Window x:Class="Rkzfps.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Rkzfps.App.ViewModels"
        xmlns:v="clr-namespace:Rkzfps.App.Views"
        Title="RKZFPS" Width="1180" Height="780" MinWidth="960" MinHeight="620"
        Background="{DynamicResource Bg}" WindowStartupLocation="CenterScreen"
        Icon="Assets/rkzfps.ico">
    <!-- Barra de titulo propria (a do Windows e' branca e destoava do app).
         WindowChrome mantem arrastar, redimensionar e o encaixe do Windows. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptimizationsViewModel}"><v:OptimizationsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamesViewModel}"><v:GamesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameplayViewModel}"><v:GameplayView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BenchmarkViewModel}"><v:BenchmarkView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><v:HistoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountViewModel}"><v:AccountView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UpdatesViewModel}"><v:UpdatesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DriversViewModel}"><v:DriversView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
    </Window.Resources>

    <Border x:Name="Root">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra de titulo: continua a cor da barra lateral e do conteudo -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Tema claro/escuro, igual ao botão do site: o ícone mostra o tema PARA ONDE
                         se vai (sol no escuro, lua no claro), e os dois trocam por giro e opacidade.
                         Desenhos do lucide (Sun e Moon), os mesmos do site. -->
                    <Button x:Name="ThemeButton" Style="{StaticResource CaptionButton}" Click="Theme_Click" Tag="dark"
                            AutomationProperties.Name="Trocar tema">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent">
                                    <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Viewbox x:Name="sun" RenderTransformOrigin="0.5,0.5" Opacity="1">
                                            <Viewbox.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                                    <RotateTransform Angle="0" />
                                                </TransformGroup>
                                            </Viewbox.RenderTransform>
                                            <Canvas Width="24" Height="24">
                                                <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="M12,2 V4 M12,20 V22 M4.93,4.93 L6.34,6.34 M17.66,17.66 L19.07,19.07 M2,12 H4 M20,12 H22 M6.34,17.66 L4.93,19.07 M19.07,4.93 L17.66,6.34" />
                                                <Ellipse Canvas.Left="8" Canvas.Top="8" Width="8" Height="8" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" />
                                            </Canvas>
                                        </Viewbox>
                                        <Viewbox x:Name="moon" RenderTransformOrigin="0.5,0.5" Opacity="0">
                                            <Viewbox.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
                                                    <RotateTransform Angle="90" />
                                                </TransformGroup>
                                            </Viewbox.RenderTransform>
                                            <Canvas Width="24" Height="24">
                                                <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeLineJoin="Round"
                                                      Data="M12,3 A6,6 0 0 0 21,12 A9,9 0 1 1 12,3 Z" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource Surface2}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                    </Trigger>
                                    <!-- 240 ms com a mesma curva do site (ease-smooth). -->
                                    <Trigger Property="Tag" Value="light">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="sun" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24" />
                                                    <DoubleAnimation Storyboard.TargetName="sun" Storyboard.TargetProperty="RenderTransform.Children[0].ScaleX" To="0.5" Duration="0:0:0.24" />
                                                    <DoubleAnimation Storyboard.TargetName="sun" Storyboard.TargetProperty="RenderTransform.Children[0].ScaleY" To="0.5" Duration="0:0:0.24" />
                                                    <DoubleAnimation Storyboard.TargetName="sun" Storyboard.TargetProperty="RenderTransform.Children[1].Angle" To="-90" Duration="0:0:0.24" />
                                                    <DoubleAnimation Storyboard.TargetName="moon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.24" />
                                                    <DoubleAnimation Storyboard.TargetName="moon" Storyboard.TargetProperty="RenderTransform.Children[0].ScaleX" To="1" Duration="0:0:0.24" />
                                                    <DoubleAnimation Storyboard.TargetName="moon" Storyboard.TargetProperty="RenderTransform.Children[0].ScaleY" To="1" Duration="0:0:0.24" />
                                                    <DoubleAnimation Storyboard.TargetName="moon" Storyboard.TargetProperty="RenderTransform.Children[1].Angle" To="0" Duration="0:0:0.24" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="sun" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.24" />
                                                    <DoubleAnimation Storyboard.TargetName="sun" Storyboard.TargetProperty="RenderTransform.Children[0].ScaleX" To="1" Duration="0:0:0.24" />
                                                    <DoubleAnimation Storyboard.TargetName="sun" Storyboard.TargetProperty="RenderTransform.Children[0].ScaleY" To="1" Duration="0:0:0.24" />
                                                    <DoubleAnimation Storyboard.TargetName="sun" Storyboard.TargetProperty="RenderTransform.Children[1].Angle" To="0" Duration="0:0:0.24" />
                                                    <DoubleAnimation Storyboard.TargetName="moon" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24" />
                                                    <DoubleAnimation Storyboard.TargetName="moon" Storyboard.TargetProperty="RenderTransform.Children[0].ScaleX" To="0.5" Duration="0:0:0.24" />
                                                    <DoubleAnimation Storyboard.TargetName="moon" Storyboard.TargetProperty="RenderTransform.Children[0].ScaleY" To="0.5" Duration="0:0:0.24" />
                                                    <DoubleAnimation Storyboard.TargetName="moon" Storyboard.TargetProperty="RenderTransform.Children[1].Angle" To="90" Duration="0:0:0.24" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimizar" Click="Minimize_Click" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximizar" Click="Maximize_Click" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Fechar" Click="Close_Click" />
                </StackPanel>
            </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Barra lateral -->
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,20">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,26">
                        <Image Source="Assets/rkzfps.ico" Width="30" Height="30" />
                        <TextBlock FontSize="22" FontWeight="Black" FontStyle="Italic" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Run Text="RKZ" /><Run Text="FPS" Foreground="{DynamicResource Accent}" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="8,0">
                        <Button Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="-6,0,0,12" Command="{Binding TutorialCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Info}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Como usar o RKZFPS" Foreground="{DynamicResource Info}" />
                            </StackPanel>
                        </Button>
                        <!-- Modo Gaming ativo, visível em qualquer tela -->
                        <Border Style="{StaticResource Chip}" Background="{DynamicResource Surface2}" Margin="0,0,0,6" ToolTip="Troque na tela FPS Boost">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{Binding GamingDot}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding GamingLabel}" FontSize="13" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Chip}" Background="{DynamicResource Surface2}" Margin="0,0,0,10">
                            <TextBlock Text="{Binding PlanLabel, StringFormat=Plano {0}}" FontSize="13" />
                        </Border>
                        <!-- Sem aviso de "sem administrador": o app pede a permissão do
                             Windows sozinho, só na hora de aplicar o que precisa dela. -->
                        <TextBlock Text="{Binding PlanHint}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"
                                   Visibility="{Binding PlanHint, Converter={StaticResource Visible}}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Pages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="nav" Style="{StaticResource NavItem}" IsChecked="{Binding IsCurrent, Mode=TwoWay}"
                                             AutomationProperties.Name="{Binding Title}"
                                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                             CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Conteúdo -->
            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Top" Background="{DynamicResource Info}" Padding="16,8"
                        Visibility="{Binding UpdateAvailable, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{Binding UpdateButton}" Command="{Binding UpdateCommand}" Padding="14,6" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding UpdateAvailable}" Foreground="{DynamicResource OnFill}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <!-- FPS ao vivo: aparece sozinho quando um jogo abre, em qualquer tela. -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="20,10"
                        Visibility="{Binding LiveFps, Converter={StaticResource Visible}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEC4A;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding LiveFps}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Accent}" />
                    </StackPanel>
                </Border>
                <ContentControl Content="{Binding Current}" />
            </DockPanel>
        </Grid>
        </Grid>
    </Border>
</Window>
