      "id": "game-mode-enable",
      "name": "Windows Game Mode",
      "category": "gaming",
      "classification": "CONDITIONAL",
      "risk": "LOW",
      "impact_area": "STUTTER",
      "description": "Reativa o Game Mode quando ele foi desligado.",
      "min_plan": "free",
      "measurement": true,
      "justification": {
        "problem": "Game Mode desligado deixa o Windows Update e notificações competirem com o jogo, e o agendador não prioriza o jogo em primeiro plano.",
        "works_on": "Windows 10 1703+ e Windows 11 com AutoGameModeEnabled = 0.",
        "does_not_work_on": "PCs onde o Game Mode já está ligado (padrão do Windows 11): nesse caso a decisão é ALREADY_OPTIMAL e nada é alterado.",
        "expected_benefit": "Baixo no FPS médio; pode reduzir quedas pontuais causadas por atividade de fundo.",
        "how_to_measure": "FPSX Benchmark antes/depois, olhando 1% low e contagem de stutter.",
        "risk": "Baixo. É o padrão do sistema.",
        "rollback": "Restaura o valor anterior de HKCU\\Software\\Microsoft\\GameBar\\AutoGameModeEnabled (ou remove o valor se ele não existia).",
        "evidence": "Recurso documentado pela Microsoft (support.microsoft.com, 'Use o Modo de Jogo ao jogar no Windows').",
        "safer_alternative": "Nenhuma: é voltar ao padrão.",
        "user_need": "Só quando alguém ou algum 'otimizador' desligou o recurso."
      }
    },
    {
