<Project>
  <!-- Configuracao comum a todos os projetos do Agent. Nullable e warnings como
       erro de proposito: um null esquecido num leitor de registro vira um
       "otimizado" falso no relatorio, e isso e' exatamente o que o FPSX promete
       nao fazer. -->
  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>0.4.2</Version>
  </PropertyGroup>
</Project>
