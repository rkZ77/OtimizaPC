{
  // Perfil do Fortnite (Epic). Chaves no formato "Secao|Chave" do arquivo
  // %LOCALAPPDATA%\FortniteGame\Saved\Config\WindowsClient\GameUserSettings.ini.
  // Nao ha' pasta de instalacao conhecida (Epic): o jogo conta como instalado
  // quando o arquivo existe, e a preferencia de GPU fica de fora.
  "id": "fortnite",
  "name": "Fortnite",
  "version": "2026.09.1",
  "detect": {
    "processes": ["FortniteClient-Win64-Shipping.exe", "FortniteLauncher.exe"],
    "by_config_file": true
  },
  "config": {
    "source": "local_appdata",
    "relative_path": "FortniteGame/Saved/Config/WindowsClient/GameUserSettings.ini",
    "format": "ini"
  },
  "optimizations": [
    "game-settings-fix",
    "game-preset-low-end"
  ],
  "setting_checks": [
    {
      "key": "/Script/FortniteGame.FortGameUserSettings|bUseVSync",
      "expect_any": ["False"],
      "severity": "ATTENTION",
      "fix_value": "False",
      "title": "V-Sync ligado",
      "why": "V-Sync segura cada quadro até a próxima atualização da tela. No Fortnite isso adiciona atraso na mira e na construção.",
      "recommendation": "No Fortnite: Configurações > Vídeo > Sincronização vertical: Desligada. Se o tearing incomodar, use um limite de FPS igual à taxa do monitor."
    }
  ],
  // Visao de distancia fica em Media, e nao no minimo: abaixo disso
  // jogadores e construcoes distantes somem, o que atrapalha a partida.
  "presets": [
    {
      "id": "pc-fraco",
      "tiers": ["LOW"],
      "title": "configuração leve para PC fraco",
      "description": "Sombras, iluminação global, reflexos, pós-processamento, efeitos, folhagem e antisserrilhado no mínimo. Distância de visão em Média, para jogadores distantes continuarem aparecendo. Resolução não muda.",
      "settings": {
        "ScalabilityGroups|sg.ViewDistanceQuality": "1",
        "ScalabilityGroups|sg.AntiAliasingQuality": "0",
        "ScalabilityGroups|sg.ShadowQuality": "0",
        "ScalabilityGroups|sg.GlobalIlluminationQuality": "0",
        "ScalabilityGroups|sg.ReflectionQuality": "0",
        "ScalabilityGroups|sg.PostProcessQuality": "0",
        "ScalabilityGroups|sg.TextureQuality": "0",
        "ScalabilityGroups|sg.EffectsQuality": "0",
        "ScalabilityGroups|sg.FoliageQuality": "0",
        "ScalabilityGroups|sg.ShadingQuality": "0"
      }
    },
    {
      "id": "equilibrado",
      "title": "configuração equilibrada para este PC",
      "tiers": [
        "MID"
      ],
      "description": "Sombras, iluminação global, reflexos e pós-processamento em Médio; texturas e distância de visão em Alto. Resolução não muda.",
      "settings": {
        "ScalabilityGroups|sg.ViewDistanceQuality": "2",
        "ScalabilityGroups|sg.AntiAliasingQuality": "2",
        "ScalabilityGroups|sg.ShadowQuality": "1",
        "ScalabilityGroups|sg.GlobalIlluminationQuality": "1",
        "ScalabilityGroups|sg.ReflectionQuality": "1",
        "ScalabilityGroups|sg.PostProcessQuality": "1",
        "ScalabilityGroups|sg.TextureQuality": "2",
        "ScalabilityGroups|sg.EffectsQuality": "2",
        "ScalabilityGroups|sg.FoliageQuality": "1",
        "ScalabilityGroups|sg.ShadingQuality": "2"
      }
    }
  ],
  // Dicas por regra (sem IA). Nomes como no menu do Fortnite em portugues.
  "tips": [
    { "id": "vsync", "setting": "Sincronização vertical", "value": "Desligada", "priority": 1, "tags": ["latency"],
      "why": "O V-Sync segura cada quadro até a próxima atualização da tela e atrasa mira e construção." },
    { "id": "reflex", "setting": "NVIDIA Reflex Low Latency", "value": "Ativado", "priority": 2, "tags": ["latency"],
      "why": "Encurta a fila de quadros quando a placa de vídeo está no limite.", "when": { "gpu_feature": "reflex" } },
    { "id": "fps-cap", "setting": "Limite de taxa de quadros", "value": "{hz} FPS, ou um valor que o PC sustente", "priority": 3, "tags": ["stability"],
      "why": "FPS estável dá movimento mais uniforme do que FPS alto que oscila." },
    { "id": "view", "setting": "Distância de visão", "value": "Média ou maior", "priority": 4, "tags": ["image"],
      "why": "Abaixo disso, jogadores e construções distantes somem." },
    { "id": "render-mode", "setting": "Modo de renderização", "value": "Desempenho", "priority": 2, "tags": ["fps"],
      "why": "Feito para PC de entrada: bem mais leve, com imagem simplificada. Pede reiniciar o jogo.", "when": { "tiers": ["LOW"], "tradeoff": ["MEDIUM"] } },
    { "id": "dlss", "setting": "NVIDIA DLSS", "value": "Qualidade", "priority": 3, "tags": ["fps"],
      "why": "Renderiza menor e reconstrói a imagem: mais FPS com pouca perda de nitidez.", "when": { "gpu_feature": "dlss", "tradeoff": ["LIGHT", "MEDIUM"] } },
    { "id": "shadows", "setting": "Sombras", "value": "Desligadas", "priority": 3, "tags": ["fps"],
      "why": "É das opções que mais pesam no Fortnite.", "when": { "tradeoff": ["LIGHT", "MEDIUM"] } },
    { "id": "gi", "setting": "Iluminação global e reflexos", "value": "Desligados", "priority": 4, "tags": ["fps"],
      "why": "Muito pesados e não ajudam a ver o adversário.", "when": { "tradeoff": ["LIGHT", "MEDIUM"] } },
    { "id": "effects", "setting": "Efeitos e pós-processamento", "value": "Baixo", "priority": 5, "tags": ["fps"],
      "why": "Explosões e fumaça pesam menos nas trocas de tiro.", "when": { "tradeoff": ["MEDIUM"] } }
  ],
  "benchmark": {
    "process": "FortniteClient-Win64-Shipping.exe",
    "processes": ["FortniteClient-Win64-Shipping.exe"],
    "duration_seconds": 60,
    "recommended_runs": 3,
    "method": "Use o Modo Criativo ou o Campo de Treino, sempre o mesmo percurso, com as mesmas opções de vídeo. Partida normal varia demais para comparar."
  },
  "recommended_settings": {
    "bUseVSync": "Desligado: menor atraso de entrada",
    "Modo de renderização": "DirectX 11 ou Desempenho em PC fraco (escolha no menu do jogo)",
    "Distância de visão": "Média ou mais, para ver jogadores distantes",
    "Limite de FPS": "Igual à taxa do monitor, ou um valor estável que o PC sustente"
  }
}
