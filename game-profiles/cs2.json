{
  // Perfil do Counter-Strike 2. Chaves de setting_checks são as do arquivo
  // Steam\userdata\<conta>\730\local\cfg\cs2_video.txt gravado pelo jogo.
  // O RKZFPS só LÊ esse arquivo: o CS2 o reescreve ao fechar.
  "id": "cs2",
  "name": "Counter-Strike 2",
  "version": "2026.09.1",
  "detect": {
    "steam_app_id": 730,
    "processes": ["cs2.exe", "cs2"],
    "executable": "game/bin/win64/cs2.exe"
  },
  "config": {
    "source": "steam_userdata",
    "relative_path": "730/local/cfg/cs2_video.txt",
    "format": "valve_kv"
  },
  "optimizations": [
    "game-mode-enable",
    "game-capture-background-recording-disable",
    "power-plan-leave-power-saver",
    "power-plan-high-performance",
    "display-refresh-rate-max",
    "startup-entry-disable",
    "background-process-close",
    "game-settings-fix",
    "game-preset-low-end",
    "game-gpu-high-performance",
    "shader-cache-clear-cs2"
  ],
  // Preset para PC de entrada. Fica de fora de proposito o que da'
  // informacao de jogo: sombras dinamicas (mostram o inimigo pela sombra) e
  // a resolucao, que o jogador escolhe pela nitidez.
  "presets": [
    {
      "id": "pc-fraco",
      "tiers": ["LOW"],
      "title": "configuração leve para PC fraco",
      "description": "Sombras, texturas, partículas, oclusão de ambiente e antisserrilhado no mínimo. Resolução e sombras dinâmicas continuam como estão.",
      "settings": {
        "setting.msaa_samples": "0",
        "setting.r_csgo_cmaa_enable": "0",
        "setting.videocfg_shadow_quality": "0",
        "setting.videocfg_texture_detail": "0",
        "setting.videocfg_particle_detail": "0",
        "setting.videocfg_ao_detail": "0",
        "setting.shaderquality": "0",
        "setting.r_texturefilteringquality": "0"
      }
    },
    {
      "id": "equilibrado",
      "title": "configuração equilibrada para este PC",
      "tiers": [
        "MID"
      ],
      "description": "Antisserrilhado 2x, sombras e texturas médias, oclusão de ambiente desligada e filtro 4x. Tira o que mais custa FPS e quase não se vê em partida.",
      "settings": {
        "setting.msaa_samples": "2",
        "setting.videocfg_shadow_quality": "1",
        "setting.videocfg_texture_detail": "1",
        "setting.videocfg_particle_detail": "1",
        "setting.videocfg_ao_detail": "0",
        "setting.r_texturefilteringquality": "3"
      }
    }
  ],
  "setting_checks": [
    {
      "key": "setting.mat_vsync",
      "expect_any": ["0"],
      "severity": "ATTENTION",
      "fix_value": "0",
      "title": "V-Sync ligado",
      "why": "V-Sync segura cada quadro até a próxima atualização da tela, o que adiciona atraso de entrada. Em jogo competitivo isso pesa mais que o tearing.",
      "recommendation": "No CS2: Configurações > Vídeo > Avançado > Esperar pela sincronização vertical: Desativado. Se o tearing incomodar, use G-Sync/FreeSync com limite de FPS abaixo da taxa do monitor."
    },
    {
      "key": "setting.r_low_latency",
      "expect_any": ["1", "2"],
      "severity": "INFO",
      "gpu_vendor": "NVIDIA",
      "fix_value": "1",
      "title": "NVIDIA Reflex desligado",
      "why": "O CS2 suporta NVIDIA Reflex, que reduz a fila de renderização e a latência do sistema quando a GPU é o gargalo.",
      "recommendation": "No CS2: Configurações > Vídeo > Avançado > NVIDIA Reflex Low Latency: Ativado."
    }
  ],
  "refresh_rate_check": {
    "numerator_key": "setting.refreshrate_numerator",
    "denominator_key": "setting.refreshrate_denominator",
    "width_key": "setting.defaultres",
    "height_key": "setting.defaultresheight"
  },
  "benchmark": {
    "process": "cs2.exe",
    "duration_seconds": 60,
    "recommended_runs": 3,
    "method": "Use sempre o mesmo cenário: mapa de benchmark da Oficina (ex.: 'CS2 FPS BENCHMARK'), mesma resolução e mesmas opções de vídeo. Inicie a captura quando o percurso começar."
  },
  // Dicas por regra (sem IA), pelo nivel do PC, pela placa e pelo perfil da
  // pessoa. Nomes como no menu do CS2 em portugues. Sem Anti-Lag da AMD: o
  // Anti-Lag+ chegou a causar banimento pelo VAC no CS2.
  "tips": [
    { "id": "vsync", "setting": "Esperar pela sincronização vertical", "value": "Desativado", "priority": 1, "tags": ["latency"],
      "why": "O V-Sync segura cada quadro até a próxima atualização da tela e soma atraso na mira." },
    { "id": "reflex", "setting": "NVIDIA Reflex Low Latency", "value": "Ativado", "priority": 2, "tags": ["latency"],
      "why": "Encurta a fila de quadros quando a placa de vídeo está no limite.", "when": { "gpu_feature": "reflex" } },
    { "id": "hz", "setting": "Taxa de atualização (Vídeo > Modo de exibição)", "value": "{hz} Hz", "priority": 2, "tags": ["latency"],
      "why": "Em tela cheia o CS2 usa a taxa dele, não a do Windows. Abaixo do monitor, a tela mostra menos quadros.", "when": { "min_hz": 75 } },
    { "id": "contrast", "setting": "Aumentar contraste do jogador", "value": "Ativado", "priority": 4, "tags": ["image"],
      "why": "Destaca os jogadores no cenário e custa pouco FPS." },
    { "id": "ao", "setting": "Oclusão de ambiente", "value": "Desativado", "priority": 3, "tags": ["fps"],
      "why": "Pesa bastante e quase não aparece em partida.", "when": { "tradeoff": ["LIGHT", "MEDIUM"] } },
    { "id": "msaa-light", "setting": "Antisserrilhado multiamostragem", "value": "2x MSAA", "priority": 3, "tags": ["fps"],
      "why": "Tira serrilhado com custo menor que 4x ou 8x.", "when": { "tradeoff": ["LIGHT"] } },
    { "id": "msaa-medium", "setting": "Antisserrilhado multiamostragem", "value": "CMAA2 ou Nenhum", "priority": 3, "tags": ["fps"],
      "why": "O MSAA é das opções que mais custam FPS em placa de entrada.", "when": { "tradeoff": ["MEDIUM"] } },
    { "id": "shadows", "setting": "Qualidade global das sombras", "value": "Baixa", "priority": 4, "tags": ["fps"],
      "why": "Baixa ainda mostra a sombra dos jogadores e alivia a placa de vídeo.", "when": { "tradeoff": ["MEDIUM"] } },
    { "id": "particles", "setting": "Detalhe de partículas", "value": "Baixo", "priority": 5, "tags": ["fps"],
      "why": "Granadas e fumaças pesam menos nas trocas de tiro.", "when": { "tradeoff": ["MEDIUM"] } },
    { "id": "fps-cap", "setting": "Máx. de quadros por segundo no jogo", "value": "{hz_cap} com G-Sync ou FreeSync; sem eles, 0 ou um valor que o PC sustente", "priority": 6, "tags": ["stability"],
      "why": "FPS estável dá movimento mais uniforme do que FPS alto que oscila." }
  ],
  "recommended_settings": {
    "mat_vsync": "0 (desligado): menor latência de entrada",
    "r_low_latency": "1 (Reflex ligado) em GPU NVIDIA",
    "refreshrate": "igual à taxa máxima do monitor",
    "fps_max": "0 ou um limite estável acima da taxa do monitor; com G-Sync/FreeSync, alguns FPS abaixo da taxa"
  }
}
